<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_result_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/notebook_cream_dark"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
        app:strokeColor="@color/notebook_line"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/text_result_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/notebook_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="\@alexwrites"
        app:layout_constraintTop_toTopOf="@id/image_result_avatar"
        app:layout_constraintStart_toEndOf="@id/image_result_avatar"
        app:layout_constraintEnd_toStartOf="@id/button_follow" />

    <TextView
        android:id="@+id/text_result_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/notebook_ink_soft"
        android:textSize="13sp"
        tools:text="Alex Rivera"
        app:layout_constraintTop_toBottomOf="@id/text_result_username"
        app:layout_constraintStart_toEndOf="@id/image_result_avatar"
        app:layout_constraintEnd_toStartOf="@id/button_follow" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_follow"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        app:cornerRadius="12dp"
        app:strokeColor="@color/notebook_ink"
        android:textColor="@color/notebook_ink"
        tools:text="Follow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>