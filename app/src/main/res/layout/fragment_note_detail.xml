<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/notebook_ink"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Back" />

        <!-- Author row (hidden for anonymous notes) -->

        <LinearLayout
            android:id="@+id/container_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/button_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_author_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@color/notebook_cream_dark"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
                app:strokeColor="@color/notebook_line"
                app:strokeWidth="1dp"
                android:contentDescription="Author" />

            <TextView
                android:id="@+id/text_author_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
                android:textColor="@color/notebook_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="@alexwrites" />

        </LinearLayout>

        <!-- The note page -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_note_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/container_author"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image_page_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.45"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_pattern_classic"
                    app:tint="@color/notebook_line"
                    tools:ignore="ContentDescription" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="280dp"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/text_note_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
                        android:textColor="@color/notebook_ink_soft"
                        android:textSize="13sp"
                        android:textStyle="italic"
                        tools:text="18 Sep 2026"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/text_note_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:lineSpacingExtra="12dp"
                        android:textAppearance="@style/TextAppearance.Notebook.Input"
                        android:textColor="@color/notebook_ink"
                        android:textSize="17sp"
                        tools:text="Today was a good day..."
                        app:layout_constraintTop_toBottomOf="@id/text_note_date"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>