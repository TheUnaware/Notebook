<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="52dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Back + title + Post -->

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            app:tint="@color/notebook_ink"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/text_editor_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/notebook_ink_soft"
            android:textSize="13sp"
            tools:text="Anonymous Note"
            app:layout_constraintTop_toTopOf="@id/button_back"
            app:layout_constraintBottom_toBottomOf="@id/button_back"
            app:layout_constraintStart_toEndOf="@id/button_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_post"
            style="@style/Widget.Notebook.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Post"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Date -->

        <TextView
            android:id="@+id/text_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
            android:textColor="@color/notebook_ink"
            android:textSize="22sp"
            tools:text="Friday, Sept 18"
            app:layout_constraintTop_toBottomOf="@id/button_back"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Template picker -->

        <TextView
            android:id="@+id/text_template_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Choose a page style"
            android:textColor="@color/notebook_ink_soft"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/text_date"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_templates"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/text_template_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_notebook_style_swatch" />

        <!-- Color picker -->

        <TextView
            android:id="@+id/text_color_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Choose a page color"
            android:textColor="@color/notebook_ink_soft"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/recycler_templates"
            app:layout_constraintStart_toStartOf="parent" />

        <HorizontalScrollView
            android:id="@+id/scroll_colors"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/text_color_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/container_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

        </HorizontalScrollView>

        <!-- Writing area -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_writing_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/scroll_colors"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image_note_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.5"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_pattern_classic"
                    app:tint="@color/notebook_line"
                    tools:ignore="ContentDescription" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/text_note_date_stamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/notebook_ink_soft"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        tools:text="18 Sep 2026"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_note_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:minHeight="260dp"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:hint="Start writing..."
                        android:inputType="textMultiLine|textCapSentences"
                        android:padding="0dp"
                        android:textAppearance="@style/TextAppearance.Notebook.Input"
                        android:textColorHint="@color/notebook_ink_soft"
                        app:layout_constraintTop_toBottomOf="@id/text_note_date_stamp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>