<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- Header -->

        <TextView
            android:id="@+id/text_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Set up your notebook"
            android:textAppearance="@style/TextAppearance.Notebook.Headline"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✎ A little cover page before you start writing"
            android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
            android:textColor="@color/notebook_maroon"
            app:layout_constraintTop_toBottomOf="@id/text_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Avatar picker -->

        <FrameLayout
            android:id="@+id/frame_avatar"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/text_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/notebook_cream_dark"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
                app:strokeColor="@color/notebook_ink"
                app:strokeWidth="2dp"
                tools:ignore="ContentDescription" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                app:cardBackgroundColor="@color/notebook_ink"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/notebook_cream"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/button_edit_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_pencil"
                    app:tint="@color/notebook_white"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <TextView
            android:id="@+id/text_add_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            android:text="Add a cover photo"
            android:textAppearance="@style/TextAppearance.Notebook.Link"
            app:layout_constraintTop_toBottomOf="@id/frame_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Form card -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/text_add_photo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_display_name"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Display name"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_username"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Username"
                    app:prefixText="/@"
                    app:prefixTextColor="@color/notebook_ink_soft"
                    app:layout_constraintTop_toBottomOf="@id/layout_display_name"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_dob"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Date of birth"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconTint="@color/notebook_ink_soft"
                    app:layout_constraintTop_toBottomOf="@id/layout_username"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_dob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:cursorVisible="false"
                        android:inputType="none"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_pronouns"
                    style="@style/Widget.Notebook.TextInputLayout.ExposedDropdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Pronouns (optional)"
                    app:layout_constraintTop_toBottomOf="@id/layout_dob"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <AutoCompleteTextView
                        android:id="@+id/input_pronouns"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_location"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Location (optional)"
                    app:layout_constraintTop_toBottomOf="@id/layout_pronouns"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_bio"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="A short note about you"
                    app:counterEnabled="true"
                    app:counterMaxLength="120"
                    app:layout_constraintTop_toBottomOf="@id/layout_location"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:maxLength="120"
                        android:minLines="3"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/notebook_maroon"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Username is already taken"
                    tools:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/layout_bio"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Washi tape accent, matches register page -->
        <View
            android:id="@+id/view_tape_accent"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-12dp"
            android:alpha="0.88"
            android:background="@drawable/shape_rounded_tape"
            android:backgroundTint="@color/notebook_coral"
            android:rotation="-5"
            app:layout_constraintStart_toStartOf="@id/card_form"
            app:layout_constraintTop_toTopOf="@id/card_form" />

        <!-- Privacy card -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_privacy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/card_form"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_privacy_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Private notebook"
                    android:textColor="@color/notebook_ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switch_privacy" />

                <TextView
                    android:id="@+id/text_privacy_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Only people you approve can follow and read your notes"
                    android:textColor="@color/notebook_ink_soft"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/text_privacy_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/switch_privacy" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_privacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="@color/notebook_white"
                    app:trackTint="@color/notebook_ink"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Notebook style picker -->

        <TextView
            android:id="@+id/text_style_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Pick a page style"
            android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
            android:textColor="@color/notebook_ink"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/card_privacy"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_style_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is how your profile pages will look to others"
            android:textColor="@color/notebook_ink_soft"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/text_style_label"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_notebook_styles"
            android:layout_width="0dp"
            android:layout_height="104dp"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/text_style_hint"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_notebook_style_swatch" />

        <!-- Continue -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_continue"
            style="@style/Widget.Notebook.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="Start writing"
            app:icon="@drawable/ic_pencil"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/notebook_white"
            app:layout_constraintTop_toBottomOf="@id/recycler_notebook_styles"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:padding="4dp"
            android:text="Skip for now"
            android:textAppearance="@style/TextAppearance.Notebook.Link"
            android:textColor="@color/notebook_ink_soft"
            app:layout_constraintTop_toBottomOf="@id/button_continue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>