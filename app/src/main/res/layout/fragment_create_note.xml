<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="What's on your mind today?"
            android:textAppearance="@style/TextAppearance.Notebook.Headline"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Choose how you want to write"
            android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
            app:layout_constraintTop_toBottomOf="@id/text_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_basic"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/text_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_basic"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/notebook_ink"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:src="@drawable/ic_basic_note"
                        app:tint="@color/notebook_white"
                        android:contentDescription="Write a note" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_basic_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Write a Note"
                    android:textColor="@color/notebook_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/icon_basic"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_basic_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Post under your name and profile"
                    android:textColor="@color/notebook_ink_soft"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/text_basic_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_daily"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/card_basic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_daily"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/notebook_coral"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:src="@drawable/ic_basic_note"
                        app:tint="@color/notebook_white"
                        android:contentDescription="Daily note" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_daily_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Daily Note"
                    android:textColor="@color/notebook_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/icon_daily"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_daily_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Visible to followers for 24 hours"
                    android:textColor="@color/notebook_ink_soft"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/text_daily_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_anonymous"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/card_daily"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/icon_anonymous"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/notebook_maroon"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp"
                        android:src="@drawable/ic_anonymous_note"
                        app:tint="@color/notebook_white"
                        android:contentDescription="Anonymous note" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_anon_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Anonymous Note"
                    android:textColor="@color/notebook_ink"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/icon_anonymous"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_anon_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Share freely — your identity stays hidden"
                    android:textColor="@color/notebook_ink_soft"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@id/text_anon_title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>