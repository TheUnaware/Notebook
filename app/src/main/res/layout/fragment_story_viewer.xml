<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_ink">

    <ImageView
        android:id="@+id/image_story_pattern"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:scaleType="fitXY"
        android:src="@drawable/ic_pattern_classic"
        app:tint="@color/notebook_white"
        android:contentDescription="Note style" />

    <View
        android:id="@+id/tap_zone_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <View
        android:id="@+id/tap_zone_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="end" />

    <TextView
        android:id="@+id/text_story_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="32dp"
        android:gravity="center"
        android:textColor="@color/notebook_white"
        android:textSize="22sp"
        android:lineSpacingExtra="8dp"
        tools:text="Today felt long but good."
        xmlns:tools="http://schemas.android.com/tools" />

    <LinearLayout
        android:id="@+id/container_progress_bars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="12dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="24dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_story_author_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@color/notebook_cream_dark"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
            android:contentDescription="Author" />

        <TextView
            android:id="@+id/text_story_author_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/notebook_white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="@alexwrites"
            xmlns:tools="http://schemas.android.com/tools" />

        <ImageView
            android:id="@+id/button_close_story"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_close"
            app:tint="@color/notebook_white"
            android:contentDescription="Close" />

    </LinearLayout>

</FrameLayout>