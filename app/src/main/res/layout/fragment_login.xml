<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- Logo badge -->

        <FrameLayout
            android:id="@+id/frame_logo_badge"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_circle_backdrop" />

            <ImageView
                android:id="@+id/image_logo"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_notebook"
                android:contentDescription="Notebook logo" />

        </FrameLayout>

        <TextView
            android:id="@+id/text_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Welcome back"
            android:textAppearance="@style/TextAppearance.Notebook.Headline"
            app:layout_constraintTop_toBottomOf="@id/frame_logo_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✎ Pick up where your last page left off"
            android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
            android:textColor="@color/notebook_coral"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/text_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="@color/notebook_white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/text_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <View
                    android:id="@+id/view_margin_line"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="-13dp"
                    android:alpha="0.55"
                    android:background="@color/notebook_coral"
                    app:layout_constraintTop_toTopOf="@id/layout_email"
                    app:layout_constraintBottom_toBottomOf="@id/layout_password"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_email"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layout_password"
                    style="@style/Widget.Notebook.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Password"
                    app:endIconMode="password_toggle"
                    app:layout_constraintTop_toBottomOf="@id/layout_email"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textAppearance="@style/TextAppearance.Notebook.Input" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/text_error"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/notebook_maroon"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Invalid email or password"
                    tools:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/layout_password"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_login"
                    style="@style/Widget.Notebook.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Log In"
                    app:icon="@drawable/ic_pencil"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/notebook_white"
                    app:layout_constraintTop_toBottomOf="@id/text_error"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Washi tape accent, drawn on top of the card's top-start corner -->
        <View
            android:id="@+id/view_tape_accent"
            android:layout_width="68dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="-12dp"
            android:alpha="0.88"
            android:background="@drawable/shape_rounded_tape"
            android:backgroundTint="@color/notebook_coral"
            android:rotation="-6"
            app:layout_constraintStart_toStartOf="@id/card_form"
            app:layout_constraintTop_toTopOf="@id/card_form" />

        <TextView
            android:id="@+id/text_go_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:padding="4dp"
            android:text="Don't have an account? Register"
            android:textAppearance="@style/TextAppearance.Notebook.Link"
            app:layout_constraintTop_toBottomOf="@id/card_form"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>