<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/notebook_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="52dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Cover page -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cover"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/notebook_line"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/image_cover_pattern"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:alpha="0.45"
                    android:src="@drawable/ic_pattern_classic"
                    app:tint="@color/notebook_line"
                    tools:ignore="ContentDescription" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Username + overflow menu / follow button -->

                    <TextView
                        android:id="@+id/text_username"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="96dp"
                        android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
                        android:textColor="@color/notebook_ink"
                        android:textSize="20sp"
                        tools:text="@alexwrites"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ImageView
                        android:id="@+id/button_more"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="4dp"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/notebook_ink"
                        app:layout_constraintTop_toTopOf="@id/text_username"
                        app:layout_constraintBottom_toBottomOf="@id/text_username"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:contentDescription="Profile options" />

                    <!-- Shown instead of button_more when viewing someone else's profile -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_follow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/notebook_ink"
                        android:textColor="@color/notebook_ink"
                        tools:text="Follow"
                        tools:visibility="visible"
                        app:layout_constraintTop_toTopOf="@id/text_username"
                        app:layout_constraintBottom_toBottomOf="@id/text_username"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Identity card -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_identity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/notebook_white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/notebook_line"
                        app:strokeWidth="1dp"
                        app:layout_constraintTop_toBottomOf="@id/text_username"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/image_avatar"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:background="@color/notebook_cream_dark"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_avatar_placeholder"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
                                app:strokeColor="@color/notebook_ink"
                                app:strokeWidth="1.5dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/text_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:textColor="@color/notebook_ink"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                tools:text="Alex Rivera"
                                app:layout_constraintTop_toTopOf="@id/image_avatar"
                                app:layout_constraintStart_toEndOf="@id/image_avatar"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/text_pronouns"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/notebook_ink_soft"
                                android:textSize="13sp"
                                tools:text="She/her"
                                app:layout_constraintTop_toBottomOf="@id/text_name"
                                app:layout_constraintStart_toEndOf="@id/image_avatar"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <TextView
                                android:id="@+id/text_bio"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/notebook_ink_soft"
                                android:textSize="13sp"
                                tools:text="Writing little things about everyday life ✎"
                                app:layout_constraintTop_toBottomOf="@id/text_pronouns"
                                app:layout_constraintStart_toEndOf="@id/image_avatar"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="@id/image_avatar" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Uploaded notes section -->

                    <TextView
                        android:id="@+id/text_notes_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Uploaded Notes"
                        android:textAppearance="@style/TextAppearance.Notebook.Subtitle"
                        android:textColor="@color/notebook_ink"
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@id/card_identity"
                        app:layout_constraintStart_toStartOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_notes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/notebook_white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/notebook_line"
                        app:strokeWidth="1dp"
                        app:layout_constraintTop_toBottomOf="@id/text_notes_label"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="220dp">

                            <TextView
                                android:id="@+id/text_notes_placeholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="No notes uploaded by user"
                                android:textColor="@color/notebook_ink_soft"
                                android:textSize="14sp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recycler_notes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:clipToPadding="false"
                                android:padding="6dp"
                                android:visibility="gone"
                                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                                app:spanCount="3"
                                tools:listitem="@layout/item_note_grid_cell"
                                tools:visibility="visible" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>