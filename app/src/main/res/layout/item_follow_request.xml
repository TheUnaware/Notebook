<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_request_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@color/notebook_cream_dark"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_avatar_placeholder"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
        app:strokeColor="@color/notebook_line"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/text_request_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/notebook_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="\@sam_writes"
        app:layout_constraintTop_toTopOf="@id/image_request_avatar"
        app:layout_constraintStart_toEndOf="@id/image_request_avatar"
        app:layout_constraintEnd_toStartOf="@id/button_decline" />

    <TextView
        android:id="@+id/text_request_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/notebook_ink_soft"
        android:textSize="12sp"
        tools:text="Sam Lee"
        app:layout_constraintTop_toBottomOf="@id/text_request_username"
        app:layout_constraintStart_toEndOf="@id/image_request_avatar"
        app:layout_constraintEnd_toStartOf="@id/button_decline" />

    <ImageView
        android:id="@+id/button_decline"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        app:tint="@color/notebook_ink_soft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/button_accept"
        android:contentDescription="Decline" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/button_accept"
        android:layout_width="34dp"
        android:layout_height="34dp"
        app:cardBackgroundColor="@color/notebook_ink"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/ic_check"
            app:tint="@color/notebook_white"
            android:contentDescription="Accept" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>