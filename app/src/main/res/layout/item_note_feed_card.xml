<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/notebook_line"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/image_card_pattern"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.4"
            android:scaleType="fitXY"
            android:src="@drawable/ic_pattern_classic"
            app:tint="@color/notebook_line"
            android:contentDescription="Note style" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <!-- Author row -->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image_card_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@color/notebook_cream_dark"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Notebook.Circle"
                app:strokeColor="@color/notebook_line"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/text_card_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/notebook_ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="@alexwrites"
                app:layout_constraintTop_toTopOf="@id/image_card_avatar"
                app:layout_constraintBottom_toBottomOf="@id/image_card_avatar"
                app:layout_constraintStart_toEndOf="@id/image_card_avatar"
                app:layout_constraintEnd_toStartOf="@id/text_card_date" />

            <TextView
                android:id="@+id/text_card_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/notebook_ink_soft"
                android:textSize="12sp"
                android:textStyle="italic"
                tools:text="18 Sep"
                app:layout_constraintTop_toTopOf="@id/image_card_avatar"
                app:layout_constraintBottom_toBottomOf="@id/image_card_avatar"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Note content -->

            <TextView
                android:id="@+id/text_card_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:maxLines="6"
                android:lineSpacingExtra="6dp"
                android:textAppearance="@style/TextAppearance.Notebook.Input"
                android:textColor="@color/notebook_ink"
                android:textSize="15sp"
                tools:text="A little note about how today went and everything I was thinking about while walking home..."
                app:layout_constraintTop_toBottomOf="@id/image_card_avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>